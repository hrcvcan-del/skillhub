{
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^next$|^_" }]
  },
  "overrides": [
    {
      "files": ["src/public/js/**/*.js"],
      "env": { "browser": true, "node": false },
      "globals": { "Chart": "readonly" }
    }
  ]
}
