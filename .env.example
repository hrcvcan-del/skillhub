# Server
PORT=3000
NODE_ENV=development

# Database (Postgres connection string, e.g. from Neon/Supabase/Render/Railway)
DATABASE_URL=postgres://user:password@host:5432/skillhub
# Set to true when connecting to a provider that requires SSL (Neon, Supabase, Render, Railway)
DATABASE_SSL=true

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# Email (transactional email for password reset) - optional, stubbed if absent
EMAIL_API_KEY=
EMAIL_FROM=no-reply@skillhub.example

# File uploads
UPLOAD_DIR=src/public/uploads
MAX_UPLOAD_MB=5
