{
  "name": "skillhub",
  "version": "1.0.0",
  "description": "SkillHub - Skill Training Institute Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
