<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0"><%= batch.batch_code %></h1>
  <div>
    <a href="/batches/<%= batch.id %>/export/joining" class="btn btn-outline-secondary btn-sm">Joining Data (Excel)</a>
    <a href="/batches/<%= batch.id %>/export/commencement" class="btn btn-outline-secondary btn-sm">Commencement Letter (Word)</a>
    <% if (['admin','director','manager','master_admin'].includes(currentUser.role)) { %>
    <form action="/batches/<%= batch.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this batch? This only works if it has no enrollments.');">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="_method" value="DELETE">
      <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
    </form>
    <% } %>
    <a href="/batches" class="btn btn-outline-secondary btn-sm">Back to batches</a>
  </div>
</div>

<form action="/batches/<%= batch.id %>/export/feedback" method="GET" class="row g-2 align-items-end mb-3">
  <div class="col-auto">
    <label class="form-label mb-0 small">Feedback Letter — Month(s)</label>
    <input type="text" name="month" class="form-control form-control-sm" placeholder="e.g. Mar-Apr-26" style="width: 160px;">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-secondary btn-sm">Feedback Letter (Word)</button>
  </div>
</form>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Status</div>
      <div class="h4 mb-0"><%= batch.status %></div>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Capacity</div>
      <div class="h4 mb-0"><%= batch.capacity %></div>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Seats Remaining</div>
      <div class="h4 mb-0"><%= seatsRemaining %></div>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Enrolled</div>
      <div class="h4 mb-0"><%= batch.enrollments.length %></div>
    </div></div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Course</dt><dd class="col-sm-9"><%= batch.course.name %></dd>
      <dt class="col-sm-3">Center</dt><dd class="col-sm-9"><a href="/centers/<%= batch.trainingCenter.id %>"><%= batch.trainingCenter.name %></a></dd>
      <dt class="col-sm-3">Trainer</dt><dd class="col-sm-9"><%= batch.trainer ? batch.trainer.name : 'Unassigned' %></dd>
      <dt class="col-sm-3">Schedule</dt><dd class="col-sm-9"><%= batch.schedule_days || '-' %>, <%= batch.start_time || '' %> - <%= batch.end_time || '' %></dd>
      <dt class="col-sm-3">Dates</dt><dd class="col-sm-9"><%= batch.start_date %> to <%= batch.end_date %></dd>
    </dl>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="h5 mb-0">Enrolled Students</h2>
      <div>
        <a href="/transfers?from_center_id=<%= batch.trainingCenter.id %>&from_batch_id=<%= batch.id %>" class="btn btn-sm btn-outline-secondary">Transfer a student</a>
        <% if (seatsRemaining > 0) { %>
        <a href="/enrollments/new?batch_id=<%= batch.id %>" class="btn btn-sm btn-outline-secondary">Enroll existing student</a>
        <a href="/students/new?center_id=<%= batch.trainingCenter.id %>&batch_id=<%= batch.id %>&lock_batch=1" class="btn btn-sm btn-primary">Add Student</a>
        <% } %>
      </div>
    </div>
    <div class="table-responsive">
      <table class="table table-sm mb-0">
        <thead><tr><th>Student</th><th>Fee Due</th><th>Status</th></tr></thead>
        <tbody>
        <% batch.enrollments.forEach(function(e) { %>
          <tr>
            <td><a href="/students/<%= e.student.id %>"><%= e.student.name %></a></td>
            <td>₹<%= Number(e.fee_due).toLocaleString('en-IN') %></td>
            <td><span class="badge text-bg-info"><%= e.status %></span></td>
          </tr>
        <% }) %>
        <% if (batch.enrollments.length === 0) { %>
          <tr><td colspan="3" class="text-center text-muted py-3">No students enrolled yet.</td></tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card mt-4">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <h2 class="h5 mb-0">Joining Data</h2>
      <a href="/batches/<%= batch.id %>/export/joining" class="btn btn-sm btn-outline-secondary">Download as Excel</a>
    </div>
    <p class="text-muted small">Same columns as the Joining Data Excel export, for a quick on-screen check right after entering students — active enrollments only.</p>
    <%
      const joiningRows = batch.enrollments.filter(function(e) { return e.status === 'active'; });
    %>
    <div class="table-responsive">
      <table class="table table-sm table-bordered mb-0" style="font-size: 0.8rem;">
        <thead>
          <tr>
            <th>Sr.No</th>
            <th>First Name</th>
            <th>Middle Name</th>
            <th>Surname</th>
            <th>Full Name</th>
            <th>Mobile Number</th>
            <th>Date of Birth</th>
            <th>Aadhar UID</th>
            <th>Permanant Address</th>
            <th>Taluka</th>
            <th>District</th>
            <th>Category</th>
            <th>Name of Caste As per Caste Certificate</th>
            <th>Non Creamy Layer (Y/N)</th>
            <th>Gender</th>
            <th>PwD (Y/N)</th>
            <th>Highest Qualification</th>
            <th>Date of Joining</th>
            <th>Remark</th>
          </tr>
        </thead>
        <tbody>
          <% joiningRows.forEach(function(e, idx) { const s = e.student; %>
          <tr>
            <td><%= idx + 1 %></td>
            <td><%= s.name || '' %></td>
            <td><%= s.middle_name || '' %></td>
            <td><%= s.last_name || '' %></td>
            <td><%= combineFullName(s) %></td>
            <td><%= s.phone || '' %></td>
            <td><%= toDDMMYYYY(s.date_of_birth) %></td>
            <td><%= s.aadhaar_number || '' %></td>
            <td><%= s.address || '' %></td>
            <td><%= s.taluka || '' %></td>
            <td><%= s.district || '' %></td>
            <td><%= s.caste_category || '' %></td>
            <td><%= s.caste_name || '' %></td>
            <td><%= s.non_creamy_layer || '' %></td>
            <td><%= s.gender || '' %></td>
            <td><%= s.pwd || '' %></td>
            <td><%= s.education || '' %></td>
            <td><%= toDDMMYYYY(e.enrollment_date) %></td>
            <td>JOINED</td>
          </tr>
          <% }) %>
          <% if (joiningRows.length === 0) { %>
          <tr><td colspan="19" class="text-center text-muted py-3">No active enrollments yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
