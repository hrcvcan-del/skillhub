<%- include('../partials/header', { title: title }) %>
<h1 class="h3 mb-3"><%= title %></h1>
<%- include('../partials/errors') %>
<div class="card">
  <div class="card-body">
    <%
      // Multipart forms aren't parsed by the app's global body parsers, so the CSRF
      // token and the _method override are passed via the query string instead.
      const userQuery = new URLSearchParams({ _csrf: csrfToken });
      if (user.id) userQuery.set('_method', 'PUT');
      const userAction = (user.id ? '/users/' + user.id : '/users') + '?' + userQuery.toString();
    %>
    <form method="POST" action="<%= userAction %>" enctype="multipart/form-data">
      <%- include('../partials/csrf') %>
      <% if (user.id) { %><input type="hidden" name="_method" value="PUT"><% } %>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Name</label>
          <input type="text" name="name" class="form-control" value="<%= user.name || '' %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" value="<%= user.email || '' %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Role</label>
          <select name="role" class="form-select" id="roleSelect" required>
            <% roles.forEach(function(r) { %>
              <option value="<%= r %>" <%= user.role === r ? 'selected' : '' %>><%= r.replace(/_/g, ' ') %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6" id="trainingPartnerField" style="display: none;">
          <label class="form-label">Training Partner</label>
          <select name="training_partner_id" class="form-select">
            <option value="">Select a training partner</option>
            <% trainingPartners.forEach(function(tp) { %>
              <option value="<%= tp.id %>" <%= user.training_partner_id == tp.id ? 'selected' : '' %>><%= tp.name %></option>
            <% }) %>
          </select>
          <div class="form-text">Add the partner first under <a href="/training-partners/new">Training Partners</a> if it's not listed.</div>
        </div>
        <div class="col-md-6">
          <label class="form-label">Phone</label>
          <input type="text" name="phone" class="form-control" value="<%= user.phone || '' %>">
        </div>
        <div class="col-12" id="payrollFields" style="display: none;">
          <div class="card bg-body-tertiary">
            <div class="card-body">
              <h2 class="h6">Payroll (hourly attendance-based salary)</h2>
              <p class="text-muted small">Fill these in so Generate Salary from Attendance can pay this person — see Staff Attendance.</p>
              <%- include('../partials/bankScanWidget', { targetName: 'name', targetAccount: 'bank_account_number', targetIfsc: 'ifsc_code', targetBank: 'bank_name', targetBranch: 'bank_branch' }) %>
              <div class="row g-3">
                <div class="col-md-3">
                  <label class="form-label">Monthly Salary</label>
                  <input type="number" min="0" step="0.01" name="salary_amount" class="form-control" value="<%= user.salary_amount || '' %>">
                </div>
                <div class="col-md-3">
                  <label class="form-label">Bank Account Number</label>
                  <input type="text" name="bank_account_number" class="form-control" value="<%= user.bank_account_number || '' %>">
                </div>
                <div class="col-md-3">
                  <label class="form-label">IFSC Code</label>
                  <input type="text" name="ifsc_code" class="form-control" value="<%= user.ifsc_code || '' %>" placeholder="e.g. HDFC0000240">
                </div>
                <div class="col-md-3">
                  <label class="form-label">Bank Name</label>
                  <input type="text" name="bank_name" class="form-control" value="<%= user.bank_name || '' %>">
                </div>
                <div class="col-md-6">
                  <label class="form-label">Bank Branch</label>
                  <input type="text" name="bank_branch" class="form-control" value="<%= user.bank_branch || '' %>">
                </div>
              </div>
              <h2 class="h6 mt-3">Identity Documents</h2>
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Aadhar Card (JPEG/PNG/PDF)</label>
                  <input type="file" name="aadhar_card" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf">
                  <% if (user.aadhar_card_url) { %>
                    <div class="form-text">Current: <a href="<%= user.aadhar_card_url %>" target="_blank" rel="noopener">view Aadhar card</a></div>
                  <% } %>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Education Certificate (JPEG/PNG/PDF)</label>
                  <input type="file" name="education_certificate" class="form-control" accept=".jpg,.jpeg,.png,.webp,.pdf">
                  <% if (user.education_certificate_url) { %>
                    <div class="form-text">Current: <a href="<%= user.education_certificate_url %>" target="_blank" rel="noopener">view certificate</a></div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <label class="form-label"><%= user.id ? 'New password (leave blank to keep current)' : 'Password' %></label>
          <input type="password" name="password" class="form-control" <%= user.id ? '' : 'required' %> minlength="8">
        </div>
        <% if (user.id) { %>
        <div class="col-md-6 d-flex align-items-end">
          <div class="form-check">
            <input type="checkbox" name="is_active" class="form-check-input" id="is_active" <%= user.is_active ? 'checked' : '' %>>
            <label class="form-check-label" for="is_active">Active</label>
          </div>
        </div>
        <% } %>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/users" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<script src="/js/user-form.js"></script>
<script src="/js/bank-document-scan.js"></script>
<%- include('../partials/footer') %>
