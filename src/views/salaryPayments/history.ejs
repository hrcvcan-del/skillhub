<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0"><%= trainer.name %> — Salary History</h1>
  <a href="/salary-payments" class="btn btn-outline-secondary btn-sm">Back to salary payments</a>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead>
      <tr><th>Period</th><th>Base</th><th>Bonus</th><th>Deduction</th><th>Net</th><th>Status</th><th>Paid On</th></tr>
    </thead>
    <tbody>
      <% payments.forEach(function(s) { %>
      <tr>
        <td><%= monthNames[s.for_month - 1] %> <%= s.for_year %></td>
        <td>₹<%= Number(s.amount).toLocaleString('en-IN') %></td>
        <td>₹<%= Number(s.bonus_amount).toLocaleString('en-IN') %></td>
        <td>₹<%= Number(s.deduction_amount).toLocaleString('en-IN') %></td>
        <td>₹<%= Number(Number(s.amount) + Number(s.bonus_amount) - Number(s.deduction_amount)).toLocaleString('en-IN') %></td>
        <td><span class="badge text-bg-secondary"><%= s.status %></span></td>
        <td><%= s.payment_date || '-' %></td>
      </tr>
      <% }) %>
      <% if (payments.length === 0) { %>
      <tr><td colspan="7" class="text-center text-muted py-4">No salary records yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
