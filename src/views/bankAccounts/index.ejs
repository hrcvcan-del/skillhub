<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Bank Accounts</h1>
  <a href="/finance/bank-accounts/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New bank account</a>
</div>

<div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead>
      <tr><th>Bank</th><th>Account Name</th><th>Account Number</th><th>IFSC</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
      <% accounts.forEach(function(a) { %>
      <tr>
        <td><%= a.bank_name %></td>
        <td><%= a.account_name %></td>
        <td><%= a.account_number %></td>
        <td><%= a.ifsc_code || '-' %></td>
        <td>
          <% if (a.is_active) { %><span class="badge text-bg-success">Active</span>
          <% } else { %><span class="badge text-bg-secondary">Inactive</span><% } %>
        </td>
        <td class="text-end">
          <a href="/finance/bank-accounts/<%= a.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
        </td>
      </tr>
      <% }) %>
      <% if (accounts.length === 0) { %>
      <tr><td colspan="6" class="text-center text-muted py-4">No bank accounts yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
