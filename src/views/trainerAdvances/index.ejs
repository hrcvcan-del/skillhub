<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Trainer Advances</h1>
  <a href="/trainer-advances/new" class="btn btn-primary">Record advance</a>
</div>

<form method="GET" class="row g-2 mb-3">
  <div class="col-auto">
    <select name="trainer_id" class="form-select">
      <option value="">All trainers</option>
      <% trainers.forEach(function(t) { %>
        <option value="<%= t.id %>" <%= filters.trainer_id == t.id ? 'selected' : '' %>><%= t.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-auto">
    <select name="status" class="form-select">
      <option value="">All statuses</option>
      <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>pending</option>
      <option value="deducted" <%= filters.status === 'deducted' ? 'selected' : '' %>>deducted</option>
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-secondary">Filter</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead>
      <tr><th>Trainer</th><th>Date</th><th>Amount</th><th>Notes</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% advances.forEach(function(a) { %>
      <tr>
        <td><a href="/salary-payments/trainer/<%= a.trainer.id %>"><%= a.trainer.name %></a></td>
        <td><%= a.advance_date %></td>
        <td>₹<%= Number(a.amount).toLocaleString('en-IN') %></td>
        <td class="text-muted small"><%= a.notes || '-' %></td>
        <td>
          <span class="badge text-bg-<%= a.status === 'deducted' ? 'success' : 'warning' %>"><%= a.status %></span>
        </td>
      </tr>
      <% }) %>
      <% if (advances.length === 0) { %>
      <tr><td colspan="5" class="text-center text-muted py-4">No advances recorded yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/pagination') %>
<%- include('../partials/footer') %>
