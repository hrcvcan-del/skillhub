<%- include('../partials/header', { title: title }) %>
<h1 class="h3 mb-3"><%= title %></h1>
<%- include('../partials/errors') %>
<div class="card">
  <div class="card-body">
    <form method="POST" action="/rent-payments">
      <%- include('../partials/csrf') %>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Training Center</label>
          <select name="training_center_id" class="form-select" required>
            <option value="">Select a center</option>
            <% centers.forEach(function(c) { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Month</label>
          <input type="number" min="1" max="12" name="for_month" class="form-control" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">Year</label>
          <input type="number" min="2000" name="for_year" class="form-control" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Amount Due</label>
          <input type="number" min="0" step="0.01" name="amount_due" class="form-control" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Due Date</label>
          <input type="date" name="due_date" class="form-control" required>
        </div>
        <div class="col-md-12">
          <label class="form-label">Notes</label>
          <input type="text" name="notes" class="form-control">
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/rent-payments" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
