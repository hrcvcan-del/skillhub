<%- include('../partials/header', { title: title }) %>
<h1 class="h3 mb-3"><%= title %></h1>
<%- include('../partials/errors') %>
<div class="card">
  <div class="card-body">
    <form method="POST" action="/mobilization">
      <%- include('../partials/csrf') %>
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Training Center</label>
          <select name="training_center_id" class="form-select" required>
            <option value="">Select a center</option>
            <% centers.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= entry.training_center_id == c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Trainer</label>
          <select name="trainer_id" class="form-select" required>
            <option value="">Select the trainer who collected the forms</option>
            <% trainers.forEach(function(t) { %>
              <option value="<%= t.id %>" <%= entry.trainer_id == t.id ? 'selected' : '' %>><%= t.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Center Coordinator</label>
          <select name="center_coordinator_id" class="form-select" required>
            <option value="">Select a coordinator</option>
            <% coordinators.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= entry.center_coordinator_id == c.id ? 'selected' : '' %>><%= c.name %><%= c.id === currentUser.id ? ' (me)' : '' %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Date Forms Taken</label>
          <input type="date" name="form_date" class="form-control" value="<%= entry.form_date || '' %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Total Forms Received</label>
          <input type="number" min="0" name="forms_submitted_count" class="form-control" value="<%= entry.forms_submitted_count || '' %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Remarks (optional)</label>
          <input type="text" name="remarks" class="form-control" value="<%= entry.remarks || '' %>">
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/mobilization" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
