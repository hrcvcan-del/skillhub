<%- include('../../partials/header', { title: title }) %>
<h1 class="h3 mb-3"><%= title %></h1>
<%- include('../../partials/errors') %>
<div class="card">
  <div class="card-body">
    <form method="POST" action="/mobilization/daily">
      <%- include('../../partials/csrf') %>
      <div class="row g-3">
        <div class="col-md-4">
          <label class="form-label">Training Center</label>
          <select name="training_center_id" class="form-select" required>
            <option value="">Select a center</option>
            <% centers.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= entry.training_center_id == c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Trainer</label>
          <select name="trainer_id" class="form-select" required>
            <option value="">Select the trainer you called</option>
            <% trainers.forEach(function(t) { %>
              <option value="<%= t.id %>" <%= entry.trainer_id == t.id ? 'selected' : '' %>><%= t.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Date</label>
          <input type="date" name="count_date" class="form-control" value="<%= entry.count_date || '' %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Admissions Done That Day</label>
          <input type="number" min="0" name="admissions_count" class="form-control" value="<%= entry.admissions_count || '' %>" required>
        </div>
        <div class="col-md-8">
          <label class="form-label">Remarks (optional)</label>
          <input type="text" name="remarks" class="form-control" value="<%= entry.remarks || '' %>">
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/mobilization/daily" class="btn btn-outline-secondary">Cancel</a>
      </div>
      <p class="text-muted small mt-2">If you've already logged this trainer and center for this date, saving again updates that day's count instead of adding a duplicate.</p>
    </form>
  </div>
</div>
<%- include('../../partials/footer') %>
