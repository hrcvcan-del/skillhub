<%- include('../partials/header', { title: title }) %>
<h1 class="h3 mb-3"><%= title %></h1>
<%- include('../partials/errors') %>
<div class="card">
  <div class="card-body">
    <form method="POST" action="/training-partner-candidates">
      <%- include('../partials/csrf') %>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Candidate Name</label>
          <input type="text" name="candidate_name" class="form-control" value="<%= candidate.candidate_name || '' %>" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">Training Cost</label>
          <input type="number" min="0.01" step="0.01" name="training_cost" class="form-control" value="<%= candidate.training_cost || '' %>" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">Trained Date</label>
          <input type="date" name="trained_date" class="form-control" value="<%= candidate.trained_date || '' %>" required>
        </div>
        <div class="col-md-12">
          <label class="form-label">Notes</label>
          <input type="text" name="notes" class="form-control" value="<%= candidate.notes || '' %>">
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/training-partner-candidates" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
