<%- include('../partials/header', { title: title }) %>
<h1 class="h3 mb-3"><%= title %></h1>
<%- include('../partials/errors') %>
<div class="card">
  <div class="card-body">
    <p class="text-muted">
      <%= enrollment.student.name %> — <%= enrollment.batch.batch_code %>
    </p>
    <form method="POST" action="/enrollments/<%= enrollment.id %>">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="_method" value="PUT">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Total Fee</label>
          <input type="number" min="0" step="0.01" name="total_fee" class="form-control" value="<%= enrollment.total_fee %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Discount Amount</label>
          <input type="number" min="0" step="0.01" name="discount_amount" class="form-control" value="<%= enrollment.discount_amount %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Status</label>
          <select name="status" class="form-select">
            <% ['active','completed','dropped'].forEach(function(s) { %>
              <option value="<%= s %>" <%= enrollment.status === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6 d-flex align-items-end">
          <div class="text-muted small">Fee paid so far: ₹<%= Number(enrollment.fee_paid).toLocaleString('en-IN') %> (recorded via payments, not editable here)</div>
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/enrollments/<%= enrollment.id %>" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
