<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Enrollment #<%= enrollment.id %></h1>
  <div>
    <a href="/enrollments/<%= enrollment.id %>/edit" class="btn btn-outline-primary btn-sm">Edit</a>
    <a href="/students/<%= enrollment.student.id %>" class="btn btn-outline-secondary btn-sm">Back to student</a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Total Fee</div>
      <div class="h4 mb-0">₹<%= Number(enrollment.total_fee).toLocaleString('en-IN') %></div>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Paid</div>
      <div class="h4 mb-0">₹<%= Number(enrollment.fee_paid).toLocaleString('en-IN') %></div>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Due</div>
      <div class="h4 mb-0">₹<%= Number(enrollment.fee_due).toLocaleString('en-IN') %></div>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Status</div>
      <div class="h4 mb-0"><%= enrollment.status %></div>
    </div></div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Student</dt><dd class="col-sm-9"><%= enrollment.student.name %></dd>
      <dt class="col-sm-3">Batch</dt><dd class="col-sm-9"><%= enrollment.batch.batch_code %> (<%= enrollment.batch.course.name %>)</dd>
      <dt class="col-sm-3">Enrolled On</dt><dd class="col-sm-9"><%= enrollment.enrollment_date %></dd>
      <dt class="col-sm-3">Discount</dt><dd class="col-sm-9">₹<%= Number(enrollment.discount_amount).toLocaleString('en-IN') %></dd>
    </dl>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <h2 class="h5">Payment History</h2>
    <div class="table-responsive">
      <table class="table table-sm mb-0">
        <thead><tr><th>Date</th><th>Amount</th><th>Mode</th><th>Receipt #</th></tr></thead>
        <tbody>
        <% enrollment.feePayments.forEach(function(p) { %>
          <tr>
            <td><%= p.payment_date %></td>
            <td>₹<%= Number(p.amount).toLocaleString('en-IN') %></td>
            <td><%= p.payment_mode %></td>
            <td><%= p.receipt_number || '-' %></td>
          </tr>
        <% }) %>
        <% if (enrollment.feePayments.length === 0) { %>
          <tr><td colspan="4" class="text-center text-muted py-3">No payments recorded yet.</td></tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
