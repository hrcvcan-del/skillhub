<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Upload Payment Confirmation</h1>
  <a href="/finance/suspense" class="btn btn-outline-secondary btn-sm">Suspense Transactions</a>
</div>
<p class="text-muted">
  After sending a batch to the bank (Trainer Salary or Rent), upload the same NEFT/RTGS Excel back once you know which
  payments went through — with a "Status"/"Remark" column added if the bank gives you one — or upload the bank
  statement itself. Rows are matched to a pending due by <strong>beneficiary account number + amount</strong> and
  marked paid automatically, the same way manually assigning a Suspense transaction does.
</p>
<%- include('../partials/errors') %>

<div class="card">
  <div class="card-body">
    <% if (bankAccounts.length === 0) { %>
      <p class="text-muted">You need to add a bank account first. <a href="/finance/bank-accounts/new">Add one now</a>.</p>
    <% } else { %>
    <%
      const uploadAction = '/finance/payment-confirmation?_csrf=' + encodeURIComponent(csrfToken);
    %>
    <form method="POST" action="<%= uploadAction %>" enctype="multipart/form-data">
      <%- include('../partials/csrf') %>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Bank Account this batch went out from</label>
          <select name="bank_account_id" class="form-select" required>
            <option value="">Select a bank account</option>
            <% bankAccounts.forEach(function(a) { %>
              <option value="<%= a.id %>"><%= a.bank_name %> - <%= a.account_name %> (<%= a.account_number %>)</option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label">Payment Date</label>
          <input type="date" name="payment_date" class="form-control" value="<%= paymentDate %>">
        </div>
        <div class="col-md-12">
          <label class="form-label">File (CSV, XLS, or XLSX)</label>
          <input type="file" name="file" class="form-control" accept=".csv,.xls,.xlsx" required>
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Upload &amp; Reconcile</button>
      </div>
    </form>
    <% } %>
  </div>
</div>

<% if (results) { %>
<div class="card mt-4">
  <div class="card-body">
    <h2 class="h6">Result</h2>
    <p>
      <span class="badge text-bg-success"><%= results.marked.length %> marked paid</span>
      <span class="badge text-bg-secondary ms-1"><%= results.failed.length %> bank-reported failed</span>
      <span class="badge text-bg-warning ms-1"><%= results.unmatched.length %> unmatched</span>
      <span class="text-muted ms-2 small">out of <%= results.totalRows %> row(s) in the file</span>
    </p>

    <% if (results.marked.length > 0) { %>
    <h3 class="h6 mt-3">Marked Paid</h3>
    <ul class="mb-0">
      <% results.marked.forEach(function(m) { %>
        <li>Row <%= m.rowNumber %>: <%= m.type %> — <%= m.name %> — ₹<%= Number(m.amount).toLocaleString('en-IN') %></li>
      <% }) %>
    </ul>
    <% } %>

    <% if (results.failed.length > 0) { %>
    <h3 class="h6 mt-3">Bank-Reported Failed (left pending)</h3>
    <ul class="mb-0">
      <% results.failed.forEach(function(f) { %>
        <li>Row <%= f.rowNumber %> (<%= f.accountNumber %>): ₹<%= Number(f.amount).toLocaleString('en-IN') %></li>
      <% }) %>
    </ul>
    <% } %>

    <% if (results.unmatched.length > 0) { %>
    <h3 class="h6 mt-3">Unmatched — needs manual review</h3>
    <ul class="mb-0">
      <% results.unmatched.forEach(function(u) { %>
        <li>Row <%= u.rowNumber %> (<%= u.accountNumber %>, ₹<%= Number(u.amount).toLocaleString('en-IN') %>): <span class="text-danger"><%= u.reason %></span></li>
      <% }) %>
    </ul>
    <p class="text-muted small mt-2">You can still assign these manually from <a href="/finance/suspense">Suspense Transactions</a>.</p>
    <% } %>
  </div>
</div>
<% } %>
<%- include('../partials/footer') %>
