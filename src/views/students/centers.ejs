<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Students</h1>
  <a href="/students" class="btn btn-outline-secondary btn-sm">Search all students</a>
</div>

<% if (centers.length === 0) { %>
<div class="card">
  <div class="card-body">
    <p class="text-muted mb-0"><%= emptyMessage %></p>
  </div>
</div>
<% } else { %>
<p class="text-muted">Pick a training center to see its batches, then open a batch to view its enrolled students or add a new one.</p>
<div class="list-group">
  <% centers.forEach(function(c) { %>
    <a href="/batches?center_id=<%= c.id %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
      <%= c.name %>
      <i class="bi bi-chevron-right"></i>
    </a>
  <% }) %>
</div>
<% } %>
<%- include('../partials/footer') %>
