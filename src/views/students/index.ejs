<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Students</h1>
  <a href="/students/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New student</a>
</div>

<form method="GET" class="row g-2 mb-3">
  <div class="col-auto">
    <input type="text" name="q" class="form-control" placeholder="Search name, email or phone" value="<%= search %>">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-secondary">Search</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead>
      <tr><th>Name</th><th>Phone</th><th>Email</th><th>Guardian</th><th></th></tr>
    </thead>
    <tbody>
      <% students.forEach(function(student) { %>
      <tr>
        <td><a href="/students/<%= student.id %>"><%= student.name %></a></td>
        <td><%= student.phone || '-' %></td>
        <td><%= student.email || '-' %></td>
        <td><%= student.guardian_name || '-' %></td>
        <td class="text-end">
          <a href="/students/<%= student.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
          <% if (['admin','manager'].includes(currentUser.role)) { %>
          <form action="/students/<%= student.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this student? This also removes their enrollments.');">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="_method" value="DELETE">
            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% if (students.length === 0) { %>
      <tr><td colspan="5" class="text-center text-muted py-4">No students found.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/pagination') %>
<%- include('../partials/footer') %>
