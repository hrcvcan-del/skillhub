<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Add Student</h1>
  <% if (lockedBatch) { %>
    <a href="/batches/<%= lockedBatch.id %>" class="btn btn-outline-secondary btn-sm">Done adding students</a>
  <% } else { %>
    <a href="/students/new" class="btn btn-outline-secondary btn-sm">Change center</a>
  <% } %>
</div>
<p class="text-muted">
  Center: <strong><%= center.name %></strong>
  <% if (lockedBatch) { %>&nbsp;|&nbsp; Batch: <strong><%= lockedBatch.batch_code %> - <%= lockedBatch.course.name %></strong><% } %>
</p>
<%- include('../partials/errors') %>
<div class="card">
  <div class="card-body">
    <form method="POST" action="/students">
      <%- include('../partials/csrf') %>
      <input type="hidden" name="center_id" value="<%= center.id %>">

      <% if (lockedBatch) { %>
        <%# Came from the batch's own "Add Student" link — the batch is
            fixed, not re-selectable, so nothing needs re-picking to add
            the next student to the same batch. %>
        <input type="hidden" name="batch_id" value="<%= lockedBatch.id %>">
        <input type="hidden" name="lock_batch" value="1">
      <% } else { %>
      <h2 class="h6">Batch</h2>
      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label">Batch</label>
          <select name="batch_id" class="form-select" required>
            <option value="">Select a batch</option>
            <% batches.forEach(function(b) { %>
              <option value="<%= b.id %>" <%= String(preselectBatchId) === String(b.id) ? 'selected' : '' %>>
                <%= b.batch_code %> - <%= b.course.name %> (<%= b.status %>)
              </option>
            <% }) %>
          </select>
          <% if (batches.length === 0) { %>
            <div class="form-text text-danger">This center has no upcoming or ongoing batches. <a href="/batches/new">Create one first</a>.</div>
          <% } %>
        </div>
      </div>
      <% } %>

      <h2 class="h6">Student Details</h2>
      <div class="row g-3">
        <div class="col-md-3">
          <label class="form-label">First Name</label>
          <input type="text" name="name" class="form-control" value="<%= student.name || '' %>" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">Middle Name</label>
          <input type="text" name="middle_name" class="form-control" value="<%= student.middle_name || '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label">Surname</label>
          <input type="text" name="last_name" class="form-control" value="<%= student.last_name || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Phone</label>
          <input type="text" name="phone" class="form-control" maxlength="10" pattern="[0-9]{10}" placeholder="10-digit number" value="<%= student.phone || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Date of Birth</label>
          <input type="date" name="date_of_birth" class="form-control" value="<%= student.date_of_birth || '' %>">
        </div>
        <div class="col-md-12">
          <label class="form-label">Address</label>
          <input type="text" name="address" class="form-control" value="<%= student.address || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Taluka</label>
          <input type="text" name="taluka" class="form-control" value="<%= student.taluka || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">District</label>
          <input type="text" name="district" class="form-control" value="<%= student.district || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Aadhaar Number</label>
          <input type="text" name="aadhaar_number" class="form-control" maxlength="12" pattern="[0-9]{12}" placeholder="12-digit number" value="<%= student.aadhaar_number || '' %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Gender</label>
          <select name="gender" class="form-select">
            <option value="">Select</option>
            <% ['Male','Female','Other'].forEach(function(g) { %>
              <option value="<%= g %>" <%= student.gender === g ? 'selected' : '' %>><%= g %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Education</label>
          <input type="text" name="education" class="form-control" placeholder="e.g. 12th Pass, B.Sc" value="<%= student.education || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Category</label>
          <input type="text" name="caste_category" class="form-control" list="casteCategoryOptions" placeholder="e.g. OBC, NT-B, VJ, SC, ST, General" value="<%= student.caste_category || '' %>">
          <datalist id="casteCategoryOptions">
            <% ['General','OBC','SC','ST','VJ','NT-B','NT-C','NT-D','SBC','EWS','Other'].forEach(function(c) { %>
              <option value="<%= c %>">
            <% }) %>
          </datalist>
        </div>
        <div class="col-md-6">
          <label class="form-label">Name of Caste (as per Caste Certificate)</label>
          <input type="text" name="caste_name" class="form-control" placeholder="e.g. KUNBI" value="<%= student.caste_name || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Non-Creamy Layer</label>
          <select name="non_creamy_layer" class="form-select">
            <option value="">Select</option>
            <option value="YES" <%= student.non_creamy_layer === 'YES' ? 'selected' : '' %>>YES</option>
            <option value="NO" <%= student.non_creamy_layer === 'NO' ? 'selected' : '' %>>NO</option>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">PwD</label>
          <select name="pwd" class="form-select">
            <option value="">Select</option>
            <option value="YES" <%= student.pwd === 'YES' ? 'selected' : '' %>>YES</option>
            <option value="NO" <%= student.pwd === 'NO' ? 'selected' : '' %>>NO</option>
          </select>
        </div>
      </div>
      <p class="text-muted small mt-3">Fee, payment, and enrollment date can be filled in afterwards from the enrollment's own Edit page — this form is just the fast path for getting a candidate joined.</p>

      <div class="mt-4">
        <button type="submit" class="btn btn-primary" <%= (!lockedBatch && batches.length === 0) ? 'disabled' : '' %>><%= lockedBatch ? 'Save & Add Another' : 'Save Student' %></button>
        <a href="/students" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
