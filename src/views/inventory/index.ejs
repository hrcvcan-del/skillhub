<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Equipment Inventory</h1>
  <div>
    <% if (['admin','manager'].includes(currentUser.role)) { %>
    <a href="/inventory/valuation" class="btn btn-outline-secondary">Valuation report</a>
    <% } %>
    <a href="/inventory/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New equipment</a>
  </div>
</div>

<div class="row g-3 mb-3">
  <div class="col-md-6">
    <div class="card <%= needsAttentionCount > 0 ? 'border-danger' : '' %>">
      <div class="card-body">
        <div class="text-muted small">Needs Repair / Damaged</div>
        <div class="h4 mb-0"><%= needsAttentionCount %></div>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card <%= warrantyExpiringCount > 0 ? 'border-warning' : '' %>">
      <div class="card-body">
        <div class="text-muted small">Warranty Expiring (next <%= warrantyAlertDays %> days)</div>
        <div class="h4 mb-0"><%= warrantyExpiringCount %></div>
      </div>
    </div>
  </div>
</div>

<form method="GET" class="row g-2 mb-3">
  <div class="col-auto">
    <select name="center_id" class="form-select">
      <option value="">All centers</option>
      <% centers.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= filters.center_id == c.id ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-auto">
    <select name="condition" class="form-select">
      <option value="">All conditions</option>
      <% conditions.forEach(function(c) { %>
        <option value="<%= c %>" <%= filters.condition === c ? 'selected' : '' %>><%= c %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-secondary">Filter</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead>
      <tr><th>Name</th><th>Center</th><th>Category</th><th>Qty</th><th>Unit Cost</th><th>Condition</th><th>Warranty Expiry</th><th></th></tr>
    </thead>
    <tbody>
      <% items.forEach(function(item) { %>
      <tr>
        <td><%= item.name %></td>
        <td><%= item.trainingCenter.name %></td>
        <td><%= item.category || '-' %></td>
        <td><%= item.quantity %></td>
        <td>₹<%= Number(item.unit_purchase_cost).toLocaleString('en-IN') %></td>
        <td>
          <% const condBadge = { new: 'success', good: 'primary', needs_repair: 'warning', damaged: 'danger', disposed: 'secondary' }; %>
          <span class="badge text-bg-<%= condBadge[item.condition] %>"><%= item.condition %></span>
        </td>
        <td><%= item.warranty_expiry_date || '-' %></td>
        <td class="text-end">
          <a href="/inventory/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
          <% if (['admin','manager'].includes(currentUser.role)) { %>
          <form action="/inventory/<%= item.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this item?');">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="_method" value="DELETE">
            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% if (items.length === 0) { %>
      <tr><td colspan="8" class="text-center text-muted py-4">No equipment found.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/pagination') %>
<%- include('../partials/footer') %>
