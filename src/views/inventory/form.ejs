<%- include('../partials/header', { title: title }) %>
<h1 class="h3 mb-3"><%= title %></h1>
<%- include('../partials/errors') %>
<div class="card">
  <div class="card-body">
    <form method="POST" action="<%= item.id ? '/inventory/' + item.id : '/inventory' %>">
      <%- include('../partials/csrf') %>
      <% if (item.id) { %><input type="hidden" name="_method" value="PUT"><% } %>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Training Center</label>
          <select name="training_center_id" class="form-select" required>
            <option value="">Select a center</option>
            <% centers.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= item.training_center_id == c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Name</label>
          <input type="text" name="name" class="form-control" value="<%= item.name || '' %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Category</label>
          <input type="text" name="category" class="form-control" placeholder="computer, projector, furniture..." value="<%= item.category || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Condition</label>
          <select name="condition" class="form-select">
            <% conditions.forEach(function(c) { %>
              <option value="<%= c %>" <%= item.condition === c ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label">Quantity</label>
          <input type="number" min="1" name="quantity" class="form-control" value="<%= item.quantity || 1 %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Unit Purchase Cost</label>
          <input type="number" min="0" step="0.01" name="unit_purchase_cost" class="form-control" value="<%= item.unit_purchase_cost || 0 %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label">Purchase Date</label>
          <input type="date" name="purchase_date" class="form-control" value="<%= item.purchase_date || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Vendor Name</label>
          <input type="text" name="vendor_name" class="form-control" value="<%= item.vendor_name || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Serial Number</label>
          <input type="text" name="serial_number" class="form-control" value="<%= item.serial_number || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Warranty Expiry Date</label>
          <input type="date" name="warranty_expiry_date" class="form-control" value="<%= item.warranty_expiry_date || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Last Maintenance Date</label>
          <input type="date" name="last_maintenance_date" class="form-control" value="<%= item.last_maintenance_date || '' %>">
        </div>
        <div class="col-md-12">
          <label class="form-label">Notes</label>
          <textarea name="notes" class="form-control" rows="2"><%= item.notes || '' %></textarea>
        </div>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/inventory" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
