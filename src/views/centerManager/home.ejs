<%- include('../partials/header', { title: title }) %>
<h1 class="h3 mb-2">Add New</h1>
<p class="text-muted mb-4">Pick what you want to add. There's no list to browse here — once saved, you'll get a confirmation and a link to add another.</p>

<div class="row g-3">
  <div class="col-md-4">
    <a href="/centers/new" class="btn btn-outline-primary w-100 py-4">
      <i class="bi bi-building d-block mb-2" style="font-size: 1.5rem;"></i>
      Add Training Center
    </a>
  </div>
  <div class="col-md-4">
    <a href="/users/new?role=center_coordinator" class="btn btn-outline-primary w-100 py-4">
      <i class="bi bi-person-badge d-block mb-2" style="font-size: 1.5rem;"></i>
      Add Center Coordinator
    </a>
  </div>
  <div class="col-md-4">
    <a href="/users/new?role=data_entry_operator" class="btn btn-outline-primary w-100 py-4">
      <i class="bi bi-keyboard d-block mb-2" style="font-size: 1.5rem;"></i>
      Add Data Entry Operator
    </a>
  </div>
  <div class="col-md-4">
    <a href="/trainers/new" class="btn btn-outline-primary w-100 py-4">
      <i class="bi bi-person-workspace d-block mb-2" style="font-size: 1.5rem;"></i>
      Add Trainer
    </a>
  </div>
  <div class="col-md-4">
    <a href="/users/new?role=mobilizer" class="btn btn-outline-primary w-100 py-4">
      <i class="bi bi-telephone d-block mb-2" style="font-size: 1.5rem;"></i>
      Add Mobilizer
    </a>
  </div>
</div>
<%- include('../partials/footer') %>
