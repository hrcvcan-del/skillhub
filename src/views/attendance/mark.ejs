<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Mark Trainer Attendance</h1>
  <% if (['admin','director','master_admin','hr'].includes(currentUser.role)) { %>
  <div>
    <a href="/attendance/summary" class="btn btn-outline-secondary me-1">Monthly Summary</a>
    <a href="/attendance/generate-salary" class="btn btn-outline-primary">Generate Salary &amp; Export</a>
  </div>
  <% } %>
</div>

<form method="GET" class="row g-2 mb-3">
  <div class="col-auto">
    <input type="date" name="date" class="form-control" value="<%= date %>" onchange="this.form.submit()">
  </div>
</form>

<% if (trainers.length === 0) { %>
<p class="text-muted">No active trainers.</p>
<% } else { %>
<form method="POST" action="/attendance">
  <%- include('../partials/csrf') %>
  <input type="hidden" name="date" value="<%= date %>">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Trainer</th>
          <th class="text-center">Present</th>
          <th class="text-center">Half Day</th>
          <th class="text-center">Absent</th>
          <th>Last Marked</th>
        </tr>
      </thead>
      <tbody>
        <% trainers.forEach(function(trainer) { %>
        <% const existing = byTrainerId.get(trainer.id); %>
        <tr>
          <td><%= trainer.name %></td>
          <td class="text-center">
            <input type="radio" class="form-check-input" name="status[t<%= trainer.id %>]" value="present" <%= existing && existing.status === 'present' ? 'checked' : '' %>>
          </td>
          <td class="text-center">
            <input type="radio" class="form-check-input" name="status[t<%= trainer.id %>]" value="half_day" <%= existing && existing.status === 'half_day' ? 'checked' : '' %>>
          </td>
          <td class="text-center">
            <input type="radio" class="form-check-input" name="status[t<%= trainer.id %>]" value="absent" <%= existing && existing.status === 'absent' ? 'checked' : '' %>>
          </td>
          <td class="small text-muted">
            <% if (existing) { %>
              <%= existing.markedByUser ? existing.markedByUser.name : '-' %>
            <% } else { %>
              Not marked
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <button type="submit" class="btn btn-primary">Save Attendance for <%= date %></button>
  <p class="text-muted small mt-2">Only trainers you select a status for are saved — leave a row untouched to mark it later.</p>
</form>
<% } %>
<%- include('../partials/footer') %>
