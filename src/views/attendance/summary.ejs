<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Monthly Attendance Summary</h1>
  <a href="/attendance" class="btn btn-outline-secondary btn-sm">Back to Mark Attendance</a>
</div>

<form method="GET" class="row g-2 mb-3">
  <div class="col-auto">
    <select name="month" class="form-select">
      <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(function(m, idx) { %>
        <option value="<%= idx + 1 %>" <%= month === idx + 1 ? 'selected' : '' %>><%= m %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-auto">
    <input type="number" name="year" class="form-control" value="<%= year %>" style="width: 100px;">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-secondary">View</button>
  </div>
</form>

<p class="small text-muted">P = Present, H = Half Day, A = Absent, blank = not marked.</p>

<div class="table-responsive">
  <table class="table table-sm table-bordered mb-0" style="font-size: 0.8rem;">
    <thead>
      <tr>
        <th style="min-width: 160px;">Trainer</th>
        <% days.forEach(function(d) { %>
          <th class="text-center"><%= d %></th>
        <% }) %>
      </tr>
    </thead>
    <tbody>
      <% trainers.forEach(function(trainer) { %>
      <tr>
        <td><%= trainer.name %></td>
        <% days.forEach(function(d) { %>
        <% const status = grid.get(trainer.id)[d]; %>
        <td class="text-center <%= status === 'present' ? 'table-success' : status === 'absent' ? 'table-danger' : status === 'half_day' ? 'table-warning' : '' %>">
          <%= status === 'present' ? 'P' : status === 'absent' ? 'A' : status === 'half_day' ? 'H' : '' %>
        </td>
        <% }) %>
      </tr>
      <% }) %>
      <% if (trainers.length === 0) { %>
      <tr><td colspan="<%= totalDays + 1 %>" class="text-center text-muted py-4">No active trainers.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>
