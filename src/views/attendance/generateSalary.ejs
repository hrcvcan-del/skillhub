<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Generate Salary from Attendance</h1>
  <a href="/attendance" class="btn btn-outline-secondary btn-sm">Back to Mark Attendance</a>
</div>
<p class="text-muted">Only actively-enrolled, monthly-salaried trainers are shown. Present days are whatever's been marked so far this month — mark the rest before generating if you're not ready.</p>

<form method="GET" class="row g-2 mb-3 align-items-end">
  <div class="col-auto">
    <label class="form-label mb-0">Month</label>
    <select name="month" class="form-select">
      <% ['January','February','March','April','May','June','July','August','September','October','November','December'].forEach(function(m, idx) { %>
        <option value="<%= idx + 1 %>" <%= month === idx + 1 ? 'selected' : '' %>><%= m %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-auto">
    <label class="form-label mb-0">Year</label>
    <input type="number" name="year" class="form-control" value="<%= year %>" style="width: 100px;">
  </div>
  <div class="col-auto">
    <label class="form-label mb-0">Days in month (for per-day rate)</label>
    <input type="number" name="total_days" class="form-control" value="<%= totalDays %>" style="width: 100px;">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-secondary">Recalculate</button>
  </div>
</form>

<% if (rows.length === 0) { %>
<p class="text-muted">No active, monthly-salaried trainers found.</p>
<% } else { %>
<form method="POST" action="/attendance/generate-salary">
  <%- include('../partials/csrf') %>
  <input type="hidden" name="month" value="<%= month %>">
  <input type="hidden" name="year" value="<%= year %>">
  <input type="hidden" name="total_days" value="<%= totalDays %>">
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th><input type="checkbox" id="selectAll" class="form-check-input"></th>
          <th>Trainer</th>
          <th class="text-end">Monthly Salary</th>
          <th class="text-end">Present Days</th>
          <th class="text-end">Per-Day Rate</th>
          <th class="text-end">Computed Amount</th>
          <th>Bank Details</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(r) { %>
        <tr>
          <td>
            <input type="checkbox" class="form-check-input trainer-checkbox" name="trainer_ids" value="<%= r.trainer.id %>" <%= r.missingBankDetails ? 'disabled' : '' %>>
          </td>
          <td><%= r.trainer.name %></td>
          <td class="text-end">₹<%= Number(r.trainer.salary_amount).toLocaleString('en-IN') %></td>
          <td class="text-end"><%= r.presentDays %> / <%= totalDays %></td>
          <td class="text-end">₹<%= r.perDayAmount.toFixed(2) %></td>
          <td class="text-end fw-bold">₹<%= r.computedAmount.toLocaleString('en-IN') %></td>
          <td>
            <% if (r.missingBankDetails) { %>
              <span class="badge text-bg-danger">Missing account/IFSC</span>
            <% } else { %>
              <span class="badge text-bg-success">OK</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <button type="submit" class="btn btn-primary">Calculate &amp; Generate Excel</button>
  <p class="text-muted small mt-2">
    Saves each selected trainer's computed amount as their salary due for the month (pending advances are auto-deducted, same as the regular monthly generator) and downloads the bank NEFT/RTGS upload file for them.
    Trainers missing an account number or IFSC code can't be included — <a href="/trainers">update their record</a> first.
  </p>
</form>
<script src="/js/attendance-generate-salary.js"></script>
<% } %>
<%- include('../partials/footer') %>
