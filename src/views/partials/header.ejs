<!DOCTYPE html>
<html lang="en">
<head>
<%- include('head', { title: typeof title !== 'undefined' ? title : 'SkillHub' }) %>
</head>
<body>
<% if (currentUser) { %>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="/dashboard">SkillHub</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMain">
      <ul class="navbar-nav me-auto">
        <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>

        <% if (currentUser.role === 'center_coordinator') { %>
          <%# Center Staff: a lean nav scoped to their own center's day-to-day
              work. No Expenses/Finance — that's master_admin/finance_director
              only, per a deliberate privacy restriction. %>
          <li class="nav-item"><a class="nav-link" href="/students">Students</a></li>
          <li class="nav-item"><a class="nav-link" href="/batches">Batches</a></li>
          <li class="nav-item"><a class="nav-link" href="/mobilization">Mobilization</a></li>
          <li class="nav-item"><a class="nav-link" href="/mobilization/summary">Mobilization Summary</a></li>
          <li class="nav-item"><a class="nav-link" href="/staff-attendance/me">My Attendance</a></li>

        <% } else if (currentUser.role === 'mobilizer') { %>
          <%# Mobilizer: calls trainers daily and logs how many admissions
              they've done, before any physical form exists. No Finance,
              no Centers/Schemes management. %>
          <li class="nav-item"><a class="nav-link" href="/mobilization/daily">Daily Admission Count</a></li>
          <li class="nav-item"><a class="nav-link" href="/mobilization/summary">Mobilization Summary</a></li>

        <% } else if (['data_entry_operator', 'verification_officer'].includes(currentUser.role)) { %>
          <%# Data Entry Operator / Verification Officer: their whole job is
              physically checking student document files against the
              mandatory-document checklist, batch by batch. No Finance, no
              Centers/Schemes management — just Students (view/add), the
              checklist, and their own clock in/out. %>
          <li class="nav-item"><a class="nav-link" href="/students">Students</a></li>
          <li class="nav-item"><a class="nav-link" href="/documents">Document Verification</a></li>
          <li class="nav-item"><a class="nav-link" href="/staff-attendance/me">My Attendance</a></li>

        <% } else if (currentUser.role === 'hr') { %>
          <%# HR: daily trainer + staff attendance and both attendance-based
              payroll exports — nothing else. Trainer/staff master data
              (bank details etc.) stays admin/manager-only; HR just flags
              what's missing. %>
          <li class="nav-item"><a class="nav-link" href="/attendance">Mark Trainer Attendance</a></li>
          <li class="nav-item"><a class="nav-link" href="/attendance/summary">Trainer Monthly Summary</a></li>
          <li class="nav-item"><a class="nav-link" href="/attendance/generate-salary">Generate Trainer Salary</a></li>
          <li class="nav-item"><a class="nav-link" href="/staff-attendance">Mark Staff Attendance</a></li>
          <li class="nav-item"><a class="nav-link" href="/staff-attendance/upload">Bulk Upload Staff Attendance</a></li>
          <li class="nav-item"><a class="nav-link" href="/staff-attendance/generate-salary">Generate Staff Salary</a></li>

        <% } else if (currentUser.role === 'finance_director') { %>
          <%# Finance Director: their whole nav is Finance, so surface it flat
              instead of nested. Full access — everything accountant sees,
              plus general Expenses, Bank Accounts/Statements/Suspense,
              Directors/Training Partners, and the assigned-entries report. %>
          <li class="nav-item"><a class="nav-link" href="/expenses">Expenses</a></li>
          <li class="nav-item"><a class="nav-link" href="/rent-payments">Center Rent Management</a></li>
          <li class="nav-item"><a class="nav-link" href="/rent-payments/generate-batch">Generate Rent Payment Batch</a></li>
          <li class="nav-item"><a class="nav-link" href="/salary-payments">Trainer Salary Management</a></li>
          <li class="nav-item"><a class="nav-link" href="/attendance/generate-salary">Generate Trainer Salary from Attendance</a></li>
          <li class="nav-item"><a class="nav-link" href="/staff-attendance/generate-salary">Generate Staff Salary from Attendance</a></li>
          <li class="nav-item"><a class="nav-link" href="/electricity-bills">Electricity Bills</a></li>
          <li class="nav-item"><a class="nav-link" href="/trainer-advances">Trainer Advances</a></li>
          <li class="nav-item"><a class="nav-link" href="/directors">Directors</a></li>
          <li class="nav-item"><a class="nav-link" href="/training-partners">Training Partners</a></li>
          <li class="nav-item"><a class="nav-link" href="/training-partner-bills">TP Bills</a></li>
          <li class="nav-item"><a class="nav-link" href="/finance/bank-accounts">Bank Accounts</a></li>
          <li class="nav-item"><a class="nav-link" href="/finance/bank-statements/upload">Upload Statement</a></li>
          <li class="nav-item"><a class="nav-link" href="/finance/suspense">Suspense Transactions</a></li>
          <li class="nav-item"><a class="nav-link" href="/finance/payment-confirmation">Upload Payment Confirmation</a></li>
          <li class="nav-item"><a class="nav-link" href="/finance/reports/assignments">Assigned Entries Report</a></li>

        <% } else if (currentUser.role === 'training_partner') { %>
          <%# Training Partner self-service: their own profile, their own
              candidates trained, their own bills — nothing else. %>
          <li class="nav-item"><a class="nav-link" href="/training-partners/profile">My Profile</a></li>
          <li class="nav-item"><a class="nav-link" href="/training-partner-candidates">Candidates Trained</a></li>
          <li class="nav-item"><a class="nav-link" href="/training-partner-bills">My Bills</a></li>

        <% } else if (currentUser.role === 'accountant') { %>
          <%# Accountant: a deliberately narrow slice of finance — Rent
              (view-only), Salary (view+update), Electricity Bills, Trainer
              Advances. No general Expenses, no Bank Accounts/Statements/
              Suspense — those stay finance_director/master_admin only. %>
          <li class="nav-item"><a class="nav-link" href="/rent-payments">Center Rent Management</a></li>
          <li class="nav-item"><a class="nav-link" href="/salary-payments">Trainer Salary Management</a></li>
          <li class="nav-item"><a class="nav-link" href="/attendance/generate-salary">Generate Trainer Salary from Attendance</a></li>
          <li class="nav-item"><a class="nav-link" href="/staff-attendance/generate-salary">Generate Staff Salary from Attendance</a></li>
          <li class="nav-item"><a class="nav-link" href="/electricity-bills">Electricity Bills</a></li>
          <li class="nav-item"><a class="nav-link" href="/trainer-advances">Trainer Advances</a></li>

        <% } else { %>
          <%# Admin/Director/Manager and other institute-wide roles: full nav,
              minus Finance — only master_admin sees that dropdown. %>
          <li class="nav-item"><a class="nav-link" href="/schemes">Schemes</a></li>
          <li class="nav-item"><a class="nav-link" href="/centers">Centers</a></li>
          <li class="nav-item"><a class="nav-link" href="/courses">Courses</a></li>
          <li class="nav-item"><a class="nav-link" href="/batches">Batches</a></li>
          <li class="nav-item"><a class="nav-link" href="/students">Students</a></li>
          <li class="nav-item"><a class="nav-link" href="/transfers">Transfer</a></li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="mobilizationDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Mobilization</a>
            <ul class="dropdown-menu" aria-labelledby="mobilizationDropdown">
              <li><a class="dropdown-item" href="/mobilization">Admission Forms</a></li>
              <li><a class="dropdown-item" href="/mobilization/daily">Daily Admission Count</a></li>
              <li><a class="dropdown-item" href="/mobilization/summary">Summary</a></li>
            </ul>
          </li>
          <li class="nav-item"><a class="nav-link" href="/trainers">Trainers</a></li>
          <li class="nav-item"><a class="nav-link" href="/inventory">Inventory</a></li>
          <% if (['admin','director','master_admin'].includes(currentUser.role)) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="documentsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Document Verification</a>
            <ul class="dropdown-menu" aria-labelledby="documentsDropdown">
              <li><a class="dropdown-item" href="/documents">Check Documents</a></li>
              <li><a class="dropdown-item" href="/documents/reports/missing">Missing Documents Report</a></li>
              <li><a class="dropdown-item" href="/documents/reports/monitor">Operator Monitoring</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="attendanceDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Attendance</a>
            <ul class="dropdown-menu" aria-labelledby="attendanceDropdown">
              <li><h6 class="dropdown-header">Trainers</h6></li>
              <li><a class="dropdown-item" href="/attendance">Mark Attendance</a></li>
              <li><a class="dropdown-item" href="/attendance/summary">Monthly Summary</a></li>
              <li><a class="dropdown-item" href="/attendance/generate-salary">Generate Salary &amp; Export</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><h6 class="dropdown-header">Staff (Data Entry Operator / Center Coordinator)</h6></li>
              <li><a class="dropdown-item" href="/staff-attendance">Mark Attendance</a></li>
              <li><a class="dropdown-item" href="/staff-attendance/summary">Monthly Summary</a></li>
              <li><a class="dropdown-item" href="/staff-attendance/upload">Bulk Upload Excel</a></li>
              <li><a class="dropdown-item" href="/staff-attendance/generate-salary">Generate Salary &amp; Export</a></li>
            </ul>
          </li>
          <% } %>
          <% if (currentUser.role === 'master_admin') { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="financeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Finance</a>
            <ul class="dropdown-menu" aria-labelledby="financeDropdown">
              <li><a class="dropdown-item" href="/expenses">Expenses</a></li>
              <li><a class="dropdown-item" href="/rent-payments">Center Rent Management</a></li>
              <li><a class="dropdown-item" href="/rent-payments/generate-batch">Generate Rent Payment Batch</a></li>
              <li><a class="dropdown-item" href="/salary-payments">Trainer Salary Management</a></li>
              <li><a class="dropdown-item" href="/electricity-bills">Electricity Bills</a></li>
              <li><a class="dropdown-item" href="/trainer-advances">Trainer Advances</a></li>
              <li><a class="dropdown-item" href="/directors">Directors</a></li>
              <li><a class="dropdown-item" href="/training-partners">Training Partners</a></li>
              <li><a class="dropdown-item" href="/training-partner-bills">TP Bills</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/finance/bank-accounts">Bank Accounts</a></li>
              <li><a class="dropdown-item" href="/finance/bank-statements/upload">Upload Bank Statement</a></li>
              <li><a class="dropdown-item" href="/finance/suspense">Suspense Transactions</a></li>
              <li><a class="dropdown-item" href="/finance/payment-confirmation">Upload Payment Confirmation</a></li>
              <li><a class="dropdown-item" href="/finance/reports/assignments">Assigned Entries Report</a></li>
            </ul>
          </li>
          <% } %>
          <% if (['admin','director','master_admin'].includes(currentUser.role)) { %>
          <li class="nav-item"><a class="nav-link" href="/users">Users</a></li>
          <% } %>
        <% } %>
      </ul>
      <ul class="navbar-nav">
        <li class="nav-item"><span class="nav-link text-light-emphasis"><%= currentUser.name %> (<%= currentUser.role %>)</span></li>
        <li class="nav-item">
          <form action="/auth/logout" method="POST" class="d-inline">
            <%- include('csrf') %>
            <button class="btn btn-outline-light btn-sm" type="submit">Logout</button>
          </form>
        </li>
      </ul>
    </div>
  </div>
</nav>
<% } %>
<main class="container mb-5">
<% if (typeof flash !== 'undefined' && flash) { %>
  <div class="alert alert-<%= flash.type === 'error' ? 'danger' : flash.type %> alert-dismissible fade show" role="alert">
    <%= flash.message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>
