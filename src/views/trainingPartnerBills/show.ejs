<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Bill #<%= bill.id %> — <%= bill.trainingPartner.name %></h1>
  <a href="/training-partner-bills" class="btn btn-outline-secondary btn-sm">Back</a>
</div>
<%- include('../partials/errors') %>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Candidates</div>
      <div class="h4 mb-0"><%= bill.candidate_count %></div>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Gross Amount</div>
      <div class="h4 mb-0">₹<%= Number(bill.gross_amount).toLocaleString('en-IN') %></div>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Deduction</div>
      <div class="h4 mb-0"><%= bill.deduction_percent ? bill.deduction_percent + '% (₹' + Number(bill.deduction_amount).toLocaleString('en-IN') + ')' : 'Not set' %></div>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card"><div class="card-body">
      <div class="text-muted small">Net Payable</div>
      <div class="h4 mb-0">₹<%= Number(bill.net_amount).toLocaleString('en-IN') %></div>
    </div></div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3">Period</dt><dd class="col-sm-9"><%= bill.period_from %> to <%= bill.period_to %></dd>
      <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><%= bill.status.replace(/_/g,' ') %></dd>
      <dt class="col-sm-3">Amount Paid</dt><dd class="col-sm-9">₹<%= Number(bill.amount_paid).toLocaleString('en-IN') %></dd>
      <dt class="col-sm-3">Generated By</dt><dd class="col-sm-9"><%= bill.generatedByUser ? bill.generatedByUser.name : '-' %></dd>
      <% if (bill.reviewedByUser) { %>
      <dt class="col-sm-3">Reviewed By</dt><dd class="col-sm-9"><%= bill.reviewedByUser.name %> on <%= new Date(bill.reviewed_at).toLocaleDateString() %></dd>
      <% } %>
    </dl>
  </div>
</div>

<% if (isFinance && bill.status === 'pending_review') { %>
<div class="card mb-4 border-warning">
  <div class="card-body">
    <h2 class="h6">Review this bill</h2>
    <form action="/training-partner-bills/<%= bill.id %>/approve" method="POST" class="row g-2 align-items-end mb-2">
      <%- include('../partials/csrf') %>
      <div class="col-auto">
        <label class="form-label mb-0">Deduction %</label>
        <input type="number" min="0" max="100" step="0.01" name="deduction_percent" class="form-control" style="width: 120px;" placeholder="e.g. 2" required>
      </div>
      <div class="col-auto">
        <button type="submit" class="btn btn-success">Approve</button>
      </div>
    </form>
    <form action="/training-partner-bills/<%= bill.id %>/reject" method="POST" onsubmit="return confirm('Reject this bill? Its candidate entries become unbilled again.');">
      <%- include('../partials/csrf') %>
      <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
    </form>
  </div>
</div>
<% } %>

<div class="card">
  <div class="card-body">
    <h2 class="h5">Candidates on this bill</h2>
    <div class="table-responsive">
      <table class="table table-sm mb-0">
        <thead><tr><th>Date</th><th>Candidate</th><th>Cost</th><th>Notes</th></tr></thead>
        <tbody>
          <% bill.candidates.forEach(function(c) { %>
          <tr>
            <td><%= c.trained_date %></td>
            <td><%= c.candidate_name %></td>
            <td>₹<%= Number(c.training_cost).toLocaleString('en-IN') %></td>
            <td class="text-muted small"><%= c.notes || '-' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
