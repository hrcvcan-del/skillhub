<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Training Centers</h1>
  <% if (['admin','director','manager','center_coordinator'].includes(currentUser.role)) { %>
  <div>
    <a href="/centers/bulk-upload" class="btn btn-outline-primary me-1"><i class="bi bi-file-earmark-excel"></i> Bulk upload</a>
    <a href="/centers/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New center</a>
  </div>
  <% } %>
</div>

<form method="GET" class="row g-2 mb-3">
  <div class="col-auto">
    <input type="text" name="q" class="form-control" placeholder="Search by name" value="<%= search %>">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-secondary">Search</button>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead>
      <tr>
        <th>Name</th>
        <th>City</th>
        <th>Scheme / Phase</th>
        <th>Coordinator</th>
        <th>Monthly Rent</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% centers.forEach(function(center) { %>
      <% const closingSoon = center.planned_closure_date && (new Date(center.planned_closure_date) - new Date()) / 86400000 <= 15 && (new Date(center.planned_closure_date) - new Date()) / 86400000 >= 0; %>
      <tr>
        <td>
          <a href="/centers/<%= center.id %>"><%= center.name %></a>
          <% if (closingSoon) { %><span class="badge text-bg-warning ms-1">Closing soon</span><% } %>
        </td>
        <td><%= center.city || '-' %></td>
        <td><%= center.schemePhase ? center.schemePhase.scheme.name + ' - ' + center.schemePhase.name : '-' %></td>
        <td><%= center.coordinator ? center.coordinator.name : '-' %></td>
        <td>₹<%= Number(center.monthly_rent_amount).toLocaleString('en-IN') %></td>
        <td>
          <% if (center.is_active) { %><span class="badge text-bg-success">Active</span>
          <% } else { %><span class="badge text-bg-secondary">Inactive</span><% } %>
        </td>
        <td class="text-end">
          <% if (['admin','director','manager','center_coordinator','center_manager'].includes(currentUser.role)) { %>
          <a href="/centers/<%= center.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a>
          <% } %>
          <% if (['admin','director'].includes(currentUser.role)) { %>
          <form action="/centers/<%= center.id %>" method="POST" class="d-inline" onsubmit="return confirm('Delete this center?');">
            <%- include('../partials/csrf') %>
            <input type="hidden" name="_method" value="DELETE">
            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
      <% if (centers.length === 0) { %>
      <tr><td colspan="7" class="text-center text-muted py-4">No training centers found.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/pagination') %>
<%- include('../partials/footer') %>
