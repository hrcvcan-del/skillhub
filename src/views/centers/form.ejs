<%- include('../partials/header', { title: title }) %>
<h1 class="h3 mb-3"><%= title %></h1>
<%- include('../partials/errors') %>
<div class="card">
  <div class="card-body">
    <form method="POST" action="<%= center.id ? '/centers/' + center.id : '/centers' %>">
      <%- include('../partials/csrf') %>
      <% if (center.id) { %><input type="hidden" name="_method" value="PUT"><% } %>
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label">Name</label>
          <input type="text" name="name" class="form-control" value="<%= center.name || '' %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">City</label>
          <input type="text" name="city" class="form-control" value="<%= center.city || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">District</label>
          <input type="text" name="district" class="form-control" value="<%= center.district || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Scheme Phase</label>
          <select name="scheme_phase_id" class="form-select">
            <option value="">Not assigned</option>
            <% phases.forEach(function(p) { %>
              <option value="<%= p.id %>" <%= center.scheme_phase_id == p.id ? 'selected' : '' %>><%= p.scheme.name %> - <%= p.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-6">
          <label class="form-label">Center Coordinator</label>
          <select name="coordinator_id" class="form-select">
            <option value="">Not assigned</option>
            <% coordinators.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= center.coordinator_id == c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="col-md-12">
          <label class="form-label">Address</label>
          <input type="text" name="address" class="form-control" value="<%= center.address || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Phone</label>
          <input type="text" name="phone" class="form-control" value="<%= center.phone || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Email</label>
          <input type="email" name="email" class="form-control" value="<%= center.email || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Capacity</label>
          <input type="number" min="0" name="capacity" class="form-control" value="<%= center.capacity || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Monthly Rent Amount</label>
          <input type="number" min="0" step="0.01" name="monthly_rent_amount" class="form-control" value="<%= center.monthly_rent_amount || 0 %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label">Landlord Name</label>
          <input type="text" name="landlord_name" class="form-control" value="<%= center.landlord_name || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Landlord Contact</label>
          <input type="text" name="landlord_contact" class="form-control" value="<%= center.landlord_contact || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Lease Start Date</label>
          <input type="date" name="lease_start_date" class="form-control" value="<%= center.lease_start_date || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Lease End Date</label>
          <input type="date" name="lease_end_date" class="form-control" value="<%= center.lease_end_date || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Planned Closure Date</label>
          <input type="date" name="planned_closure_date" class="form-control" value="<%= center.planned_closure_date || '' %>">
          <div class="form-text">We'll flag this center 15 days before this date so you can notify the owner.</div>
        </div>
        <%- include('../partials/bankScanWidget', { targetName: 'landlord_name', targetAccount: 'owner_bank_account_number', targetIfsc: 'owner_ifsc_code', targetBank: 'owner_bank_name' }) %>
        <div class="col-md-4">
          <label class="form-label">Owner Bank Account Number</label>
          <input type="text" name="owner_bank_account_number" class="form-control" value="<%= center.owner_bank_account_number || '' %>">
        </div>
        <div class="col-md-4">
          <label class="form-label">Owner IFSC Code</label>
          <input type="text" name="owner_ifsc_code" class="form-control" value="<%= center.owner_ifsc_code || '' %>" placeholder="e.g. HDFC0000240">
          <div class="form-text">Needed for the bulk rent payment bank Excel — see Center Rent Management.</div>
        </div>
        <div class="col-md-4">
          <label class="form-label">Owner Bank Name</label>
          <input type="text" name="owner_bank_name" class="form-control" value="<%= center.owner_bank_name || '' %>">
        </div>
        <div class="col-md-6">
          <label class="form-label">Owner UPI ID</label>
          <input type="text" name="owner_upi_id" class="form-control" placeholder="name@bank" value="<%= center.owner_upi_id || '' %>">
        </div>
        <% if (center.id) { %>
        <div class="col-md-6 d-flex align-items-end">
          <div class="form-check">
            <input type="checkbox" name="is_active" class="form-check-input" id="is_active" <%= center.is_active ? 'checked' : '' %>>
            <label class="form-check-label" for="is_active">Active</label>
          </div>
        </div>
        <% } %>
      </div>
      <div class="mt-4">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="<%= currentUser.role === 'center_coordinator' ? '/dashboard' : '/centers' %>" class="btn btn-outline-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
<script src="/js/bank-document-scan.js"></script>
<%- include('../partials/footer') %>
