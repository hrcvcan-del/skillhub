<!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Reset password' }) %>
</head>
<body class="bg-light">
<div class="container d-flex align-items-center justify-content-center" style="min-height: 100vh;">
  <div class="card shadow-sm" style="width: 100%; max-width: 400px;">
    <div class="card-body p-4">
      <h1 class="h4 mb-3 text-center">Reset password</h1>
      <% if (invalid) { %>
        <p class="alert alert-danger">This reset link is invalid or has expired.</p>
        <a href="/auth/forgot-password" class="btn btn-primary w-100">Request a new link</a>
      <% } else { %>
        <%- include('../partials/errors') %>
        <form method="POST" action="/auth/reset-password/<%= token %>">
          <%- include('../partials/csrf') %>
          <div class="mb-3">
            <label class="form-label">New password</label>
            <input type="password" name="password" class="form-control" required minlength="8">
          </div>
          <div class="mb-3">
            <label class="form-label">Confirm password</label>
            <input type="password" name="password_confirmation" class="form-control" required minlength="8">
          </div>
          <button type="submit" class="btn btn-primary w-100">Reset password</button>
        </form>
      <% } %>
    </div>
  </div>
</div>
</body>
</html>
