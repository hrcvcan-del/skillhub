<%- include('../partials/header', { title: title }) %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Electricity Bills</h1>
  <a href="/electricity-bills/new" class="btn btn-primary">Record bill</a>
</div>

<form method="GET" class="row g-2 mb-3">
  <div class="col-auto">
    <select name="center_id" class="form-select">
      <option value="">All centers</option>
      <% centers.forEach(function(c) { %>
        <option value="<%= c.id %>" <%= filters.center_id == c.id ? 'selected' : '' %>><%= c.name %></option>
      <% }) %>
    </select>
  </div>
  <div class="col-auto">
    <input type="date" name="from" class="form-control" value="<%= filters.from %>" placeholder="From">
  </div>
  <div class="col-auto">
    <input type="date" name="to" class="form-control" value="<%= filters.to %>" placeholder="To">
  </div>
  <div class="col-auto">
    <button type="submit" class="btn btn-outline-secondary">Filter</button>
  </div>
  <div class="col-auto ms-auto">
    <span class="text-muted">Total: <strong>₹<%= Number(totalAmount).toLocaleString('en-IN') %></strong></span>
  </div>
</form>

<div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead>
      <tr><th>Date</th><th>Center</th><th>Description</th><th>Amount</th></tr>
    </thead>
    <tbody>
      <% bills.forEach(function(b) { %>
      <tr>
        <td><%= b.expense_date %></td>
        <td><%= b.trainingCenter ? b.trainingCenter.name : 'Institute-wide' %></td>
        <td><%= b.description || '-' %></td>
        <td>₹<%= Number(b.amount).toLocaleString('en-IN') %></td>
      </tr>
      <% }) %>
      <% if (bills.length === 0) { %>
      <tr><td colspan="4" class="text-center text-muted py-4">No electricity bills recorded yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
<%- include('../partials/pagination') %>
<%- include('../partials/footer') %>
